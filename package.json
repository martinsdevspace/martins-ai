    "html2canvas-pro": "^2.3.8",
    "jspdf": "^4.2.1",
    "next": "16.3.0",
    "next-sitemap": "^4.2.3",
    "payload": "4.0.0-canary.28",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.71.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.59.1",
