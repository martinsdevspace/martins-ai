{
  "name": "martinsai",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=production payload build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && bun build && bun start",
    "gen:map": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "gen:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation bun --ignore-workspace install",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm bun-lock.yaml && bun --ignore-workspace install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "bun run test:int && bun run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.69",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@payloadcms/admin-bar": "4.0.0-canary.28",
    "@payloadcms/db-postgres": "4.0.0-canary.28",
    "@payloadcms/db-sqlite": "4.0.0-canary.28",
    "@payloadcms/email-resend": "4.0.0-canary.28",
    "@payloadcms/live-preview-react": "4.0.0-canary.28",
    "@payloadcms/next": "4.0.0-canary.28",
    "@payloadcms/plugin-form-builder": "4.0.0-canary.28",
    "@payloadcms/plugin-mcp": "4.0.0-canary.28",
    "@payloadcms/plugin-nested-docs": "4.0.0-canary.28",
    "@payloadcms/plugin-redirects": "4.0.0-canary.28",
    "@payloadcms/plugin-search": "4.0.0-canary.28",
    "@payloadcms/plugin-seo": "4.0.0-canary.28",
    "@payloadcms/richtext-lexical": "4.0.0-canary.28",
    "@payloadcms/storage-vercel-blob": "4.0.0-canary.28",
    "@payloadcms/ui": "4.0.0-canary.28",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tabler/icons-react": "^3.46.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
