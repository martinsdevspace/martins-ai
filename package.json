    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "trustedDependencies": [
    "core-js",
    "unrs-resolver"
  ]
